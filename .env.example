# Google Analytics measurement id (optional)
NEXT_PUBLIC_MEASUREMENT_ID=
# Deployed origin, used for absolute URLs in metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=https://portfolio-xabdomos-projects.vercel.app

# Optional. A classic GitHub token for your own account lets the GitHub section
# show the real contributions calendar for the past year and raises the API
# rate limit. Give it the `repo` scope so private contributions are counted,
# as on your profile when signed in; repositories shown are always the public
# ones. Without a token, the section builds an activity calendar from the last
# 90 days of public events. Server-side only; never exposed to the browser.
GITHUB_TOKEN=

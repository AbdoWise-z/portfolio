# Google Analytics measurement id (optional)
NEXT_PUBLIC_MEASUREMENT_ID=
# Deployed origin, used for absolute URLs in metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=https://portfolio-xabdomos-projects.vercel.app

# Optional. A GitHub token with no scopes lets the GitHub section show the real
# contributions calendar for the past year and raises the API rate limit.
# Without it, the section builds an activity calendar from the last 90 days of
# public events. Server-side only; never exposed to the browser.
GITHUB_TOKEN=

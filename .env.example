# Google Analytics measurement id (optional)
NEXT_PUBLIC_MEASUREMENT_ID=
# Deployed origin, used for absolute URLs in metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=https://portfolio-xabdomos-projects.vercel.app

# Optional. The GitHub section reads the contributions calendar from the public
# profile page, which counts private contributions when "Include private
# contributions on my profile" is on in GitHub settings, so no token is needed.
# A classic token for your own account (with the `repo` scope) raises the API
# rate limit and counts private contributions even without that setting.
# Repositories shown are always the public ones. Server-side only; never
# exposed to the browser.
GITHUB_TOKEN=
